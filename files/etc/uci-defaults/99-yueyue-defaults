#!/bin/sh
# 月月岛科技 — 首次开机默认配置
# 首次启动由 luci-app-yueyuewizard 引导，本脚本只铺默认值

# 主机名
uci -q set system.@system[0].hostname='月月岛科技'
uci -q set system.@system[0].timezone='CST-8'
uci -q set system.@system[0].zonename='Asia/Shanghai'

# LAN 网段: 192.168.21.1/24
uci -q set network.lan.ipaddr='192.168.21.1'
uci -q set network.lan.netmask='255.255.255.0'

# WiFi 默认: yueyue-opwrt / yueyuedaotech
uci -q set wireless.@wifi-iface[0].ssid='yueyue-opwrt'
uci -q set wireless.@wifi-iface[0].key='yueyuedaotech'
uci -q set wireless.@wifi-iface[0].encryption='psk2+ccmp'

# 后台账号 root/root (首次引导里提示修改)
(echo 'root'; sleep 1; echo 'root') | passwd root >/dev/null 2>&1

uci commit
exit 0
