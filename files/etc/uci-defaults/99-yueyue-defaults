#!/bin/sh
# 月月岛科技 — 首次开机默认配置
# 首次登录由 luci-app-yueyuewizard 引导，本脚本只铺默认值

# 主机名
uci -q set system.@system[0].hostname='月月岛科技'
uci -q set system.@system[0].timezone='CST-8'
uci -q set system.@system[0].zonename='Asia/Shanghai'

# LAN 网段: 192.168.21.1/24 (网段 21)
uci -q set network.lan.ipaddr='192.168.21.1'
uci -q set network.lan.netmask='255.255.255.0'

# WiFi 默认: yueyue-opwrt / opwrt
uci -q set wireless.@wifi-iface[0].ssid='yueyue-opwrt'
uci -q set wireless.@wifi-iface[0].key='opwrt'
uci -q set wireless.@wifi-iface[0].encryption='psk2+ccmp'

# 后台账号 root/root (首次引导强制提示修改)
(echo 'root'; sleep 1; echo 'root') | passwd root >/dev/null 2>&1

# 向导状态标志: 首次登录进入引导
touch /etc/config/yueyue
uci -q set yueyue.wizard=yueyue
uci -q set yueyue.wizard.done='0'

# 个性化默认值 (背景图 / 遮罩 / 主题)
uci -q set yueyue.personalization=yueyue
uci -q set yueyue.personalization.bg_mode='builtin'
uci -q set yueyue.personalization.overlay='60'
uci -q set yueyue.personalization.blur='14'
uci -q set yueyue.personalization.radius='18'
uci -q set yueyue.personalization.accent='#7fe7d2'
uci -q set yueyue.personalization.theme='dark'

# 流量/性能采样守护 (按 IP 流量统计 + 性能历史)
mkdir -p /etc/yueyue
chmod 755 /www/cgi-bin/yueyue /etc/init.d/yueyue-monitor 2>/dev/null
/etc/init.d/yueyue-monitor enable
/etc/init.d/yueyue-monitor start

# WAN 口默认 eth1 DHCP（board.json 只声明 lan，这里补齐，保证首启 WAN 可用）
if ! uci -q get network.wan >/dev/null; then
  uci -q set network.wan=interface
  uci -q set network.wan.device='eth1'
  uci -q set network.wan.proto='dhcp'
fi

uci commit
exit 0
