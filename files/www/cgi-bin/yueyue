-- 纯 Lua base64 编码（busybox 无 base64 命令时使用）
local B64CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local function b64encode(data)
	local out = {}
	local len = #data
	local i = 1
	while i <= len do
		local a = data:byte(i)
		local b = data:byte(i + 1)
		local c = data:byte(i + 2)
		local n = a * 65536 + (b or 0) * 256 + (c or 0)
		local q1 = math.floor(n / 262144) % 64
		local q2 = math.floor(n / 4096) % 64
		local q3 = math.floor(n / 64) % 64
		local q4 = n % 64
		out[#out + 1] = B64CHARS:sub(q1 + 1, q1 + 1) .. B64CHARS:sub(q2 + 1, q2 + 1)
			.. (b and B64CHARS:sub(q3 + 1, q3 + 1) or "=")
			.. (c and B64CHARS:sub(q4 + 1, q4 + 1) or "=")
		i = i + 3
	end
	return table.concat(out)
end

function act.backup()
	need_root()
	os.execute("rm -f /tmp/yy-backup.tar.gz")
	os.execute("sysupgrade -b /tmp/yy-backup.tar.gz >/dev/null 2>&1")
	local f = io.open("/tmp/yy-backup.tar.gz", "rb")
	if not f then fail("备份生成失败") end
	local data = f:read("*a") or ""
	f:close()
	if #data == 0 then fail("备份生成失败") end
	reply({ ok = true, filename = "yueyue-backup-" .. os.date("%Y%m%d") .. ".tar.gz", data = b64encode(data) })
end

function act.restore()
	need_root()
	if not body_raw or #body_raw < 100 then fail("空的备份文件") end
	local f = io.open("/tmp/yy-restore.tar.gz", "w")
	if not f then fail("写入失败") end
	f:write(body_raw)
	f:close()
	local outp = exec("tar tzf /tmp/yy-restore.tar.gz | head -5")
	if #outp == 0 then fail("备份文件损坏") end
	os.execute("nohup sh -c 'sleep 2; tar xzf /tmp/yy-restore.tar.gz -C /; reboot' >/dev/null 2>&1 &")
	reply({ ok = true, msg = "配置已恢复，系统即将重启" })
end

function act.upgrade()
	need_root()
	if not body_raw or #body_raw < 1024 then fail("空的固件文件") end
	-- 校验 gzip magic (img.gz) 或 uImage
	local is_gz = body_raw:sub(1, 2) == "\31\139"
	local f = io.open("/tmp/yy-firmware.bin", "w")
	if not f then fail("写入失败") end
	f:write(body_raw)
	f:close()
	local cmd
	if is_gz then
		cmd = "gunzip -t /tmp/yy-firmware.bin"
	else
		cmd = "true"
	end
	if os.execute(cmd) ~= 0 and os.execute(cmd) ~= true then
		os.execute("rm -f /tmp/yy-firmware.bin")
		fail("固件文件校验失败")
	end
	os.execute("nohup sh -c 'sleep 2; sysupgrade -n /tmp/yy-firmware.bin' >/dev/null 2>&1 &")
	reply({ ok = true, msg = "固件上传完成，系统即将刷写并重启" })
end

function act.reboot()
	need_root()
	os.execute("nohup sh -c 'sleep 2; reboot' >/dev/null 2>&1 &")
	reply({ ok = true, msg = "系统即将重启" })
end

