-- 动作: 性能历史
------------------------------------------------------------

function act.perf()
	local data = read_json_file("/tmp/yueyue/perf.json") or { samples = {} }
	local limit = math.min(argn("limit", 2880), 2880)
	local s = data.samples or {}
	local start = math.max(1, #s - limit + 1)
	local rows = {}
	for i = start, #s do
		rows[#rows + 1] = s[i]
	end
	reply({ ok = true, samples = rows, interval = 30, time = now() })
end

------------------------------------------------------------
-- 动作: 路由可视化 (拓扑 / 静态路由)
------------------------------------------------------------

local function mask2prefix(m)
	if not m or m == "" then return 32 end
	if m:match("^%d+$") then return tonumber(m) end
	local n = 0
	for oct in m:gmatch("%d+") do
		local o = tonumber(oct) or 0
		while o > 0 do n = n + (o % 2); o = math.floor(o / 2) end
	end
	return n
end

local function prefix2mask(p)
	p = tonumber(p) or 32
	p = math.max(0, math.min(32, p))
	local parts = {}
	for i = 1, 4 do
		local bits = math.max(0, math.min(8, p - (i - 1) * 8))
		parts[i] = tostring(256 - 2 ^ (8 - bits))
	end
	return table.concat(parts, ".")
end

local function safe_sid(id)
	local s = tostring(id or ""):gsub("[^%w_]", "")
	if #s == 0 then s = "rt" .. tostring(now()) end
	return s
end

local function iface_list()
	local byname = {}
	local ok, data = pcall(jsonc.parse, exec("ubus -S call network.interface dump"))
	if ok and data and data.interface then
		for _, itf in ipairs(data.interface) do
			local ipv4 = itf["ipv4-address"] and itf["ipv4-address"][1]
			local gw = nil
			if type(itf.route) == "table" then
				for _, rt in ipairs(itf.route) do
					if type(rt) == "table" and tostring(rt.target or "0.0.0.0") == "0.0.0.0" then
						local nh = rt.nexthop
						if type(nh) == "string" then gw = nh
						elseif type(nh) == "table" then gw = nh[1] end
						if gw then break end
					end
				end
			end
			byname[itf.interface] = {
				up = itf.up and true or false,
				ipaddr = ipv4 and ipv4.address or nil,
				netmask = ipv4 and ipv4.mask or nil,
				gateway = gw,
				uptime = itf.uptime or nil,
				device = itf.l3_device or itf.device or "",
			}
		end
	end

	local outif = {}
	for name, s in pairs(ucicursor:get_all("network") or {}) do
		if s[".type"] == "interface" then
			local st = byname[name] or {}
			outif[#outif + 1] = {
				name = name,
				device = st.device or s.device or s.ifname or "",
				ipaddr = st.ipaddr or s.ipaddr,
				netmask = st.netmask or s.netmask,
				gateway = st.gateway or nil,
				uptime = st.uptime or nil,
				proto = s.proto or "static",
				up = st.up and true or false,
			}
		end
	end
	table.sort(outif, function(a, b) return a.name < b.name end)
	return outif
end

local function static_routes()
	local out = {}
	for name, s in pairs(ucicursor:get_all("network") or {}) do
		if s[".type"] == "route" then
			local target = s.target or "0.0.0.0"
			local cidr
			if target:find("/") then cidr = target
			else cidr = target .. "/" .. tostring(mask2prefix(s.netmask)) end
			out[#out + 1] = {
				id = name, target = cidr, gateway = s.gateway or "",
				iface = s.interface or "lan", metric = tonumber(s.metric) or 0,
				enabled = s.disabled ~= "1", source = "static", table = "main",
			}
		end
	end
	return out
end

local function runtime_routes()
	local out = {}
	local ok, list = pcall(jsonc.parse, exec("ip -j route show table all"))
	if not (ok and type(list) == "table") then return out end
	local ifaces = iface_list()
	for i, e in ipairs(list) do
		local dst = e.dst or e.destination
		if dst then
			if dst == "default" then dst = "0.0.0.0/0"
			elseif not dst:find("/") then dst = dst .. "/32" end
			local ifname = e.dev or ""
			for _, f in ipairs(ifaces) do
				if f.device == ifname then ifname = f.name break end
			end
			out[#out + 1] = {
				id = "rt" .. tostring(i), target = dst, gateway = e.gateway or "",
				iface = ifname, metric = tonumber(e.metric) or 0,
				enabled = true, source = "runtime", table = e.table or "main",
			}
		end
	end
	return out
end

function act.topology()
	local routes = static_routes()
	for _, r in ipairs(runtime_routes()) do
		routes[#routes + 1] = r
	end
	local layout = {}
	local raw = ucicursor:get("yueyue", "wizard", "flow_layout")
	if raw then
		local ok, data = pcall(jsonc.parse, raw)
		if ok and type(data) == "table" then layout = data end
	end
	local pending = #(exec("uci changes network"):gsub("%s", "")) > 0
	reply({ ok = true, ifaces = iface_list(), routes = routes, layout = layout, pending = pending })
end

function act.route_save()
	need_root()
	local r = body and body.route
	if not r or not r.target or not r.iface then fail("缺少 route 字段") end

	local sid = safe_sid(r.id)
	local target = tostring(r.target)
	local addr, prefix = target:match("^([^/]+)/(%d+)$")

	ucicursor:set("network", sid, "route")
	if addr then
		ucicursor:set("network", sid, "target", addr)
		ucicursor:set("network", sid, "netmask", prefix2mask(prefix))
	else
		ucicursor:set("network", sid, "target", target)
	end
	ucicursor:set("network", sid, "interface", tostring(r.iface))
	ucicursor:set("network", sid, "metric", tostring(tonumber(r.metric) or 0))
	if r.gateway and #tostring(r.gateway) > 0 then
		ucicursor:set("network", sid, "gateway", tostring(r.gateway))
	else
		ucicursor:delete("network", sid, "gateway")
	end
	if r.enabled == false then
		ucicursor:set("network", sid, "disabled", "1")
	else
		ucicursor:delete("network", sid, "disabled")
	end
	ucicursor:save("network")
	reply({ ok = true, id = sid })
end

function act.route_delete()
	need_root()
	local id = body and body.id
	if not id then fail("缺少 id") end
	ucicursor:delete("network", safe_sid(id))
	ucicursor:save("network")
	reply({ ok = true })
end

function act.layout_save()
	need_root()
	if not body or type(body.layout) ~= "table" then fail("缺少 layout") end
	ucicursor:set("yueyue", "wizard", "flow_layout", jsonc.stringify(body.layout))
	ucicursor:commit("yueyue")
	reply({ ok = true })
end

function act.apply()
	need_root()
	ucicursor:commit("network")
	exec("/etc/init.d/network reload")
	reply({ ok = true })
end

------------------------------------------------------------
-- 动作: 向导 (移植自 luci-app-yueyuewizard)
------------------------------------------------------------

local function wifi_devs()
	local devs = {}
	for line in exec("ls -d /sys/class/net/*/wireless"):gmatch("[^\n]+") do
		local d = line:match("/net/([^/]+)/wireless")
		if d then devs[#devs + 1] = d end
	end
	return devs
end

local function radio_for_dev(dev)
	local ok, data = pcall(jsonc.parse, exec("ubus -S call network.wireless status"))
	if ok and data then
		for radio, r in pairs(data) do
			for _, itf in ipairs(r.interfaces or {}) do
				if itf.ifname == dev then return radio end
			end
		end
	end
	return ucicursor:get("wireless", "@wifi-iface[0]", "device") or "radio0"
end

local function scan_dev(dev)
	local aps = {}
	local ok, data = pcall(jsonc.parse,
		exec("ubus -S call iwinfo scan " .. shq(jsonc.stringify({ device = dev }))))
	if ok and data and data.results then
		for _, r in ipairs(data.results) do
			aps[#aps + 1] = {
				ssid = r.ssid or "", bssid = r.bssid or "",
				channel = r.channel or 0, signal = r.signal or 0, quality = r.quality or 0,
				encryption = (r.encryption and r.encryption.enabled) and
					((r.encryption.wpa and r.encryption.wpa > 0) and "wpa" or "wep") or "none",
				device = dev,
			}
		end
		return aps
	end
	local cell
	for line in exec("iwinfo " .. shq(dev) .. " scan"):gmatch("[^\n]+") do
		if line:match("Cell %d+") then
			if cell then aps[#aps + 1] = cell end
			cell = { ssid = "", channel = 0, signal = 0, encryption = "none", device = dev }
		elseif cell then
			local ssid = line:match('ESSID:%s*"([^"]*)"')
			if ssid then cell.ssid = ssid end
			local ch = line:match("Channel:%s*(%d+)")
			if ch then cell.channel = tonumber(ch) end
			local sig = line:match("Signal:%s*(-?%d+)")
			if sig then cell.signal = tonumber(sig) end
			if line:match("Encryption:%s*WPA") then cell.encryption = "wpa"
			elseif line:match("Encryption:%s*WEP") then cell.encryption = "wep" end
		end
	end
	if cell then aps[#aps + 1] = cell end
	return aps
end

local function firewall_add_zone_network(zone_name, net)
	for k, z in pairs(ucicursor:get_all("firewall") or {}) do
		if z[".type"] == "zone" and z.name == zone_name then
			for _, n in ipairs(ucicursor:get_list("firewall", k, "network") or {}) do
				if n == net then return end
			end
			ucicursor:append("firewall", k, "network", net)
			return
		end
	end
end

local function firewall_new_zone(name, net)
	local id = ucicursor:add("firewall", "zone")
	ucicursor:set("firewall", id, "name", name)
	ucicursor:set_list("firewall", id, "network", { net })
	ucicursor:set("firewall", id, "input", "accept")
	ucicursor:set("firewall", id, "output", "accept")
	ucicursor:set("firewall", id, "forward", "reject")
	local fwd = ucicursor:add("firewall", "forwarding")
	ucicursor:set("firewall", fwd, "src", name)
	ucicursor:set("firewall", fwd, "dest", "wan")
end

local function reload_network()
	exec("wifi reload")
	exec("/etc/init.d/network reload")
end

function act.wizard_status()
	reply({
		ok = true,
		done = ucicursor:get("yueyue", "wizard", "done") == "1",
		hostname = ucicursor:get("system", "@system[0]", "hostname") or "OpenWrt",
		lan_ip = ucicursor:get("network", "lan", "ipaddr") or "192.168.21.1",
		wan_proto = ucicursor:get("network", "wan", "proto") or "dhcp",
		uplink = ucicursor:get("network", "wwan", "proto") and true or false,
		main_router = ucicursor:get("yueyue", "wizard", "main_router") ~= "0",
		version = distro_version(),
	})
end

function act.wizard_scan()
	local all = {}
	for _, dev in ipairs(wifi_devs()) do
		for _, ap in ipairs(scan_dev(dev)) do
			all[#all + 1] = ap
		end
	end
