	reply({ ok = true, aps = all, devices = wifi_devs() })
end

function act.wizard_uplink()
	need_root()
	local action = tostring(arg("uplink_action") or arg("action") or "wisp")
	local dev = arg("device")
	local ssid = arg("ssid")
