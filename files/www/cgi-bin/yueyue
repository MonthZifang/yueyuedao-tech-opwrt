-- 个性化配置的读取是纯展示用途，允许未登录读（登录页主题）；写入仍要求 root
if name == "personalization" and METHOD == "GET" then
	act.personalization()
end

-- 其余全部要求登录
auth()

local fn = act[name]
if not fn then fail("未知动作: " .. name, 404) end

local ok, err = pcall(fn)
if not ok then
	fail("内部错误: " .. tostring(err), 500)
end
