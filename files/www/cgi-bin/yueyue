#!/usr/bin/lua
------------------------------------------------------------
-- 月月岛科技 · 统一 API (CGI)   /cgi-bin/yueyue
--
-- 取代原 LuCI Lua controller (yueyueconsole / yueyuewizard)，
-- 供 React 控制台 SPA 统一调用。
--
-- 认证: ?auth=<ubus session id> 或 Cookie: ubus_rpc_session=<id>
--       通过 `ubus call session get` 校验；写操作要求 root。
--
-- 用法: GET  /cgi-bin/yueyue?action=<name>&...
--       POST /cgi-bin/yueyue?action=<name>  (JSON body 或裸二进制)
------------------------------------------------------------

local jsonc = require "luci.jsonc"
local sys   = require "luci.sys"
local ucicursor = require "luci.model.uci".cursor()

------------------------------------------------------------
-- CGI 基础
------------------------------------------------------------

local function env(k, d)
	return os.getenv(k) or d
end

local METHOD = env("REQUEST_METHOD", "GET")
local QSTR   = env("QUERY_STRING", "")
local CLEN   = tonumber(env("CONTENT_LENGTH", "0")) or 0
local COOKIE = env("HTTP_COOKIE", "")

-- query 参数表
local q = {}
for k, v in QSTR:gmatch("([^&=]+)=([^&]*)") do
	q[k] = v:gsub("%%(%x%x)", function(h) return string.char(tonumber(h, 16)) end)
end

-- POST body (一次读入)
local body_raw = nil
if METHOD == "POST" and CLEN > 0 then
	if CLEN > 32 * 1024 * 1024 then
		io.stdout:write("Status: 413 Payload Too Large\r\nContent-Type: application/json\r\n\r\n")
		io.stdout:write('{"ok":false,"msg":"body too large"}')
		os.exit(0)
	end
	body_raw = io.stdin:read(CLEN)
end

local body = nil
if body_raw and #body_raw > 0 and body_raw:sub(1, 1) == "{" then
	local ok, v = pcall(jsonc.parse, body_raw)
	if ok then body = v end
end

local function arg(name, default)
	if q[name] ~= nil then return q[name] end
	if body and body[name] ~= nil then return body[name] end
	return default
end

local function argn(name, default)
	local v = tonumber(arg(name))
	return v or default
end

local out = {}
local function reply(t)
	io.stdout:write("Content-Type: application/json\r\nCache-Control: no-store\r\n\r\n")
	io.stdout:write(jsonc.stringify(t or {}))
	os.exit(0)
end

local function fail(msg, code)
	io.stdout:write("Status: " .. (code or 400) .. " Error\r\nContent-Type: application/json\r\n\r\n")
	io.stdout:write(jsonc.stringify({ ok = false, msg = msg or "error" }))
	os.exit(0)
end

local function shq(s)
	return "'" .. tostring(s):gsub("'", "'\\''") .. "'"
end

local function slurp(p)
	local f = io.open(p, "r")
	if not f then return "" end
	local d = f:read("*a") or ""
	f:close()
	return d
end

local function exec(cmd)
	local p = io.popen(cmd .. " 2>/dev/null")
	if not p then return "" end
	local d = p:read("*a") or ""
	p:close()
	return d
end

------------------------------------------------------------
-- 认证
------------------------------------------------------------

local function cookie_val(name)
	for k, v in COOKIE:gmatch("([^=;%s]+)=([^;]*)") do
		if k == name then return v end
	end
	return nil
end

local session_user = nil
local function auth()
	local sid = arg("auth") or cookie_val("ubus_rpc_session")
	if not sid or #sid ~= 32 or sid:find("[^%w]") then
		fail("未登录", 401)
	end
	local raw = exec("ubus -S call session get " ..
		shq(jsonc.stringify({ ubus_rpc_session = sid })))
	local ok, data = pcall(jsonc.parse, raw)
	if ok and type(data) == "table" and type(data.values) == "table" and data.values.username then
		session_user = data.values.username
		return true
	end
	fail("会话无效或已过期", 401)
end

local function need_root()
	if session_user ~= "root" then
		fail("需要 root 权限", 403)
	end
end

------------------------------------------------------------
-- 通用工具
------------------------------------------------------------

local function read_json_file(p)
	local d = slurp(p)
	if #d == 0 then return nil end
	local ok, v = pcall(jsonc.parse, d)
	if ok then return v end
	return nil
end

local function now() return os.time() end

-- /etc/openwrt_release 版本描述
local function distro_version()
	local v = slurp("/etc/openwrt_release"):match('DISTRIB_DESCRIPTION=.([^"\n]+)')
	return (v or "OpenWrt"):gsub("'", "")
end

-- DHCP 租约 IP -> 主机名
local function lease_hosts()
	local hosts = {}
	for line in slurp("/tmp/dhcp.leases"):gmatch("[^\n]+") do
		local mac, ip, name = line:match("^(%S+)%s+(%S+)%s+(%S+)")
		if ip then hosts[ip] = name end
	end
	return hosts
end

------------------------------------------------------------
-- 动作: 基础信息
------------------------------------------------------------

local act = {}

function act.public_info()
	reply({
		ok = true,
		hostname = ucicursor:get("system", "@system[0]", "hostname") or "OpenWrt",
		version = distro_version(),
		wizard_done = ucicursor:get("yueyue", "wizard", "done") == "1",
		time = now(),
	})
end

function act.sysinfo()
	local cpu = {}
	local n = {}
	for v in (slurp("/proc/stat"):match("^cpu%s+([%d%s]+)") or ""):gmatch("%d+") do
		n[#n + 1] = tonumber(v)
	end
	cpu.user, cpu.nice, cpu.system, cpu.idle = n[1] or 0, n[2] or 0, n[3] or 0, n[4] or 0
	cpu.iowait, cpu.irq, cpu.softirq = n[5] or 0, n[6] or 0, n[7] or 0
	cpu.total = cpu.user + cpu.nice + cpu.system + cpu.idle + cpu.iowait + cpu.irq + cpu.softirq

	local mem = {}
	for k, v in slurp("/proc/meminfo"):gmatch("([%w_]+):%s*(%d+)") do
		mem[k] = tonumber(v) * 1024
	end

	local load = {}
	for v in slurp("/proc/loadavg"):gmatch("[%d%.]+") do
		load[#load + 1] = tonumber(v)
		if #load >= 3 then break end
	end
	local uptime = tonumber(slurp("/proc/uptime"):match("[%d%.]+")) or 0

	local net = {}
	for line in slurp("/proc/net/dev"):gmatch("[^\n]+") do
		local name, rx, tx = line:match("^%s*([%w%._%-]+):%s*(%d+)%s+%d+%s+%d+%s+%d+%s+%d+%s+%d+%s+%d+%s+%d+%s+(%d+)")
		if name then net[name] = { rx = tonumber(rx), tx = tonumber(tx) } end
	end

	local ifaces = {}
	local raw = exec("ubus -S call network.interface dump")
	local ok, data = pcall(jsonc.parse, raw)
	if ok and data and data.interface then
		for _, itf in ipairs(data.interface) do
			local ipaddr = nil
			if type(itf["ipv4-address"]) == "table" and itf["ipv4-address"][1] then
				ipaddr = itf["ipv4-address"][1].address
			end
			ifaces[#ifaces + 1] = {
				name = itf.interface or "?",
				up = itf.up and true or false,
				proto = itf.proto,
				device = itf.l3_device or itf.device,
				ipaddr = ipaddr,
				uptime = itf.uptime,
				gateway = (itf.route and itf.route[1]) and itf.route[1].nexthop or nil,
			}
		end
	end

	local disk = nil
	local df = exec("df -k /")
	local used, avail, total, pct = df:match("^%S+%s+(%d+)%s+(%d+)%s+(%d+)%s+(%d+)%%")
	if used then
		disk = { used = tonumber(used) * 1024, free = tonumber(avail) * 1024,
		         total = tonumber(total) * 1024, pct = tonumber(pct) }
	end

	local conn = 0
	local f = io.open("/proc/net/nf_conntrack", "r")
	if f then
		for _ in f:lines() do conn = conn + 1 end
		f:close()
	end

	reply({
		ok = true, cpu = cpu, mem = mem, load = load, uptime = uptime,
		net = net, ifaces = ifaces, disk = disk, conn = conn,
		version = distro_version(), hostname = ucicursor:get("system", "@system[0]", "hostname"),
		time = now(),
	})
end

------------------------------------------------------------
-- 动作: 流量统计 (由 yueyue-monitor 采样)
------------------------------------------------------------

function act.traffic()
	local data = read_json_file("/tmp/yueyue/traffic.json") or { months = {}, ips = {} }
	local ym = arg("month") or os.date("%Y-%m")

	local months = {}
	for k, v in pairs(data.months or {}) do
		months[#months + 1] = { ym = k, up = v.up, down = v.down }
	end
	table.sort(months, function(a, b) return a.ym > b.ym end)

	local ips = {}
	for ip, e in pairs((data.ips or {})[ym] or {}) do
		local dests = {}
		for _, d in pairs(e.dests or {}) do
			dests[#dests + 1] = { dst = d.dst, port = d.port, proto = d.proto,
			                     bytes = d.bytes, first = d.first, last = d.last }
		end
		table.sort(dests, function(a, b) return a.bytes > b.bytes end)
		ips[#ips + 1] = { ip = ip, up = e.up, down = e.down,
		                  total = e.up + e.down, first = e.first, last = e.last,
		                  dests = dests }
	end
	table.sort(ips, function(a, b) return a.total > b.total end)

	local month = data.months and data.months[ym] or { up = 0, down = 0 }
	reply({
		ok = true, month = ym,
		totals = { up = month.up, down = month.down },
		months = months, ips = ips,
		hosts = lease_hosts(),
	})
end

function act.flows()
	local ip = arg("ip")
	local limit = math.min(argn("limit", 200), 500)
	local rows = {}
	local f = io.open("/proc/net/nf_conntrack", "r")
	if f then
		for line in f:lines() do
			local proto = line:match("^%S+%s+%d+%s+(%S+)")
			local state = line:match("^%S+%s+%d+%s+%S+%s+%d+%s+%d+%s+(%S+)")
			if state == "src" or state == nil then state = "" end
			local osrc, odst, osport, odport, opkts, obytes =
				line:match("src=([^ ]+)%s+dst=([^ ]+)%s+sport=(%d+)%s+dport=(%d+)%s+packets=(%d+)%s+bytes=(%d+)")
			local rbytes, assured = nil, line:find("%[ASSURED%]") ~= nil
			local _, e1 = line:find("bytes=%d+")
			if osrc and e1 then
				local rsrc, rdst, rsport, rdport, rpkts, rb =
					line:sub(e1 + 1):match("src=([^ ]+)%s+dst=([^ ]+)%s+sport=(%d+)%s+dport=(%d+)%s+packets=(%d+)%s+bytes=(%d+)")
				rbytes = tonumber(rb)
				if osrc and (not ip or osrc == ip or odst == ip) and not osrc:find(":") then
					rows[#rows + 1] = {
						proto = proto, state = state,
						src = osrc, sport = tonumber(osport),
						dst = odst, dport = tonumber(odport),
						bytes_up = tonumber(obytes) or 0,
						bytes_down = rbytes or 0,
						assured = assured,
					}
				end
			end
			if #rows >= limit then break end
		end
		f:close()
	end
	table.sort(rows, function(a, b) return (a.bytes_up + a.bytes_down) > (b.bytes_up + b.bytes_down) end)
	reply({ ok = true, flows = rows, count = #rows, hosts = lease_hosts() })
end

