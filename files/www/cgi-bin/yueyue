function act.dhcp_leases()
	local rows = {}
	local now = os.time()
	local f = io.open("/tmp/dhcp.leases", "r")
	if f then
		for line in f:lines() do
			-- 格式: 到期时间戳 MAC IP 主机名 客户端ID
			local exp, mac, ip, host = line:match("^(%S+)%s+(%S+)%s+(%S+)%s+(%S+)")
			if ip then
				local e = tonumber(exp) or 0
				local remain = e - now
				if e == 0 then remain = 0 end  -- 0 = 永久
				rows[#rows + 1] = {
					mac = mac, ip = ip,
					hostname = (host and host ~= "*") and host or "",
					expires = remain > 0 and remain or 0,
				}
			end
		end
		f:close()
	end
	reply({ ok = true, leases = rows })
end

function act.processes()
	local rows = {}
	for line in exec("top -bn1"):gmatch("[^\n]+") do
		local pid, ppid, user, stat, vsz, vsp, cpu, cmd =
			line:match("^%s*(%d+)%s+(%d+)%s+(%S+)%s+(%S+)%s+(%d+)%s+(%d+)%%%s+(%d+)%%%s+(.*)")
		if pid then
			rows[#rows + 1] = { pid = tonumber(pid), ppid = tonumber(ppid), user = user, stat = stat,
			                    vsz = tonumber(vsz), mem_pct = tonumber(vsp),
			                    cpu_pct = tonumber(cpu), cmd = cmd }
		end
	end
	table.sort(rows, function(a, b) return (a.cpu_pct or 0) > (b.cpu_pct or 0) end)
	reply({ ok = true, processes = rows })
end

local function valid_service(name)
	return name and #name <= 48 and name:match("^[%w%._%-]+$") ~= nil
end

function act.services()
	local op = tostring(arg("op") or "list")
	if op == "list" then
		-- running: ubus service list; enabled: /etc/rc.d/S* 软链
		local running = {}
		local ok, data = pcall(jsonc.parse, exec("ubus -S call service list"))
		if ok and type(data) == "table" then
			for name, s in pairs(data) do running[name] = true end
		end
		local enabled = {}
		for line in exec("ls /etc/rc.d/S*"):gmatch("[^\n]+") do
			local n = line:match("/S%d+(.+)$")
			if n then enabled[n] = true end
		end
		local rows = {}
		for line in exec("ls /etc/init.d"):gmatch("[^\n]+") do
			if line:match("^[%w%._%-]+$") then
				rows[#rows + 1] = { name = line, running = running[line] and true or false,
				                   enabled = enabled[line] and true or false }
			end
		end
		table.sort(rows, function(a, b) return a.name < b.name end)
		reply({ ok = true, services = rows })
	end

	need_root()
	local name = tostring(arg("name") or "")
	if not valid_service(name) then fail("服务名非法") end
	if not io.open("/etc/init.d/" .. name, "r") then fail("服务不存在") end

	local map = { enable = "enable", disable = "disable", start = "start",
	              stop = "stop", restart = "restart", reload = "reload" }
	local sub = map[op]
	if not sub then fail("未知操作") end
	local code = os.execute("/etc/init.d/" .. name .. " " .. sub .. " >/dev/null 2>&1")
	reply({ ok = code == 0 or code == true, op = op, name = name })
end

