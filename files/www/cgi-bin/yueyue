function act.wizard_mode()
	need_root()
	local mode = tostring(arg("mode") or "simple")

	-- 网络角色：是否为主路由（主路由 = LAN DHCP 服务；二级路由 = 关闭本机 DHCP，由上级下发地址）
	local mr = arg("main_router")
	if mr ~= nil then
		local is_main = tostring(mr) ~= "0"
		ucicursor:set("yueyue", "wizard", "main_router", is_main and "1" or "0")
		for dname, ds in pairs(ucicursor:get_all("dhcp") or {}) do
			if ds[".type"] == "dhcp" and (ds.interface or "") == "lan" then
				ucicursor:set("dhcp", dname, "ignore", is_main and "0" or "1")
			end
		end
		ucicursor:commit("yueyue")
		ucicursor:commit("dhcp")
		reload_network()
		exec("/etc/init.d/dnsmasq reload >/dev/null 2>&1")
	end

	if mode == "simple" then
		reply({ ok = true, mode = "simple" })
		return
	end

	if mode == "mesh" then
		local mesh_id = tostring(arg("mesh_id") or "yueyue-mesh")
		local key = arg("mesh_key")
		local radio = ucicursor:get("wireless", "@wifi-iface[0]", "device") or "radio0"

		local counts = {}
		for _, dev in ipairs(wifi_devs()) do
			for _, ap in ipairs(scan_dev(dev)) do
				local ch = tonumber(ap.channel) or 0
				if ch > 0 then counts[ch] = (counts[ch] or 0) + 1 end
			end
		end
		local candidates = { 1, 6, 11 }
		local best, bestn = nil, math.huge
		for _, ch in ipairs(candidates) do
			if (counts[ch] or 0) < bestn then best, bestn = ch, (counts[ch] or 0) end
		end

		ucicursor:set("wireless", "yueyue_mesh", "wifi-iface")
		ucicursor:set("wireless", "yueyue_mesh", "device", radio)
		ucicursor:set("wireless", "yueyue_mesh", "mode", "mesh")
		ucicursor:set("wireless", "yueyue_mesh", "mesh_id", mesh_id)
		ucicursor:set("wireless", "yueyue_mesh", "mesh_fwding", "1")
		ucicursor:set("wireless", "yueyue_mesh", "network", "lan")
		if key and #tostring(key) >= 8 then
			ucicursor:set("wireless", "yueyue_mesh", "encryption", "sae")
			ucicursor:set("wireless", "yueyue_mesh", "key", key)
		else
			ucicursor:set("wireless", "yueyue_mesh", "encryption", "none")
		end
		if best then ucicursor:set("wireless", radio, "channel", best) end
		ucicursor:commit("wireless")
		reload_network()
		reply({ ok = true, mode = "mesh", mesh_id = mesh_id, channel = best })
		return
	end

	if mode == "vlan" then
		local count = math.max(2, math.min(4, argn("count", 3)))
		local names, keys = {}, {}
		for i = 1, count do
			names[i] = tostring(arg("name" .. i) or ("yueyue-" .. (21 + i)))
			keys[i] = tostring(arg("key" .. i) or ("opwrt" .. (21 + i)))
		end

		local radio = ucicursor:get("wireless", "@wifi-iface[0]", "device") or "radio0"
		for i = 1, count do
			local net = "lan" .. (21 + i)
			ucicursor:set("network", net, "interface")
			ucicursor:set("network", net, "proto", "static")
			ucicursor:set("network", net, "ipaddr", "192.168." .. (21 + i) .. ".1")
			ucicursor:set("network", net, "netmask", "255.255.255.0")

			local h = ucicursor:add("dhcp", "dhcp")
			ucicursor:set("dhcp", h, "interface", net)
			ucicursor:set("dhcp", h, "start", "100")
			ucicursor:set("dhcp", h, "limit", "150")
			ucicursor:set("dhcp", h, "leasetime", "12h")

			local w = ucicursor:add("wireless", "wifi-iface")
			ucicursor:set("wireless", w, "device", radio)
			ucicursor:set("wireless", w, "mode", "ap")
			ucicursor:set("wireless", w, "network", net)
			ucicursor:set("wireless", w, "ssid", names[i])
			ucicursor:set("wireless", w, "encryption", "psk2+ccmp")
			ucicursor:set("wireless", w, "key", keys[i])

			firewall_new_zone(net, net)
		end
		ucicursor:commit("network")
		ucicursor:commit("dhcp")
		ucicursor:commit("wireless")
		ucicursor:commit("firewall")
		reload_network()
		reply({ ok = true, mode = "vlan", count = count })
		return
	end

	fail("未知模式")
end

