local function sniff_image(d)
	if d:sub(1, 3) == "\255\216\255" then return "jpg" end
	if d:sub(1, 4) == "\137\080\078\071" then return "png" end
	if d:sub(1, 4) == "GIF8" then return "gif" end
	if d:sub(1, 4) == "RIFF" and d:sub(9, 12) == "WEBP" then return "webp" end
	if d:sub(1, 5) == "<?xml" or d:sub(1, 4) == "<svg" then return "svg" end
	return nil
end

function act.bg_upload()
	need_root()
	if not body_raw or #body_raw < 100 then fail("空的上传内容") end
	if #body_raw > 8 * 1024 * 1024 then fail("图片过大 (≤8MB)") end
	local ext = sniff_image(body_raw)
	if not ext then fail("仅支持 JPG/PNG/GIF/WebP/SVG") end

	os.execute("rm -f " .. BG_DIR .. "/bg-custom.*")
	local fname = "bg-custom." .. ext
	local f = io.open(BG_DIR .. "/" .. fname, "w")
	if not f then fail("写入失败") end
	f:write(body_raw)
	f:close()

	ucicursor:set("yueyue", "personalization", "bg_mode", "custom")
	ucicursor:set("yueyue", "personalization", "bg_file", fname)
	ucicursor:commit("yueyue")
	reply({ ok = true, file = fname, personalization = personalization_get() })
end

