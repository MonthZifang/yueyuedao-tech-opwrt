local function valid_pkg(p)
	return p and #p <= 96 and p:match("^[%w%.+_%-]+$") ~= nil
end

-- 包管理器: OpenWrt 25.12 为 apk，旧版为 opkg
local PKGMGR = nil
local function pkgmgr()
	if PKGMGR then return PKGMGR end
	if exec("which apk"):find("apk") then PKGMGR = "apk"
	elseif exec("which opkg"):find("opkg") then PKGMGR = "opkg"
	else PKGMGR = "apk" end
	return PKGMGR
end

function act.opkg()
	local op = tostring(arg("op") or "list")
	local pm = pkgmgr()
	if op == "list" or op == "installed" then
		local rows = {}
		local outp = (pm == "apk") and exec("apk list --installed") or exec("opkg list-installed")
		for line in outp:gmatch("[^\n]+") do
			local pkg, ver
			if pm == "apk" then
				pkg, ver = line:match("^(.-)%-(%d[%w%.%-%+]*)%s")
			else
				pkg, ver = line:match("^(%S+)%s+%-%s+(%S+)")
			end
			if pkg then rows[#rows + 1] = { name = pkg, version = ver } end
		end
		table.sort(rows, function(a, b) return a.name < b.name end)
		reply({ ok = true, packages = rows, manager = pm })
	elseif op == "search" then
		local kw = tostring(arg("keyword") or "")
		if #kw == 0 then fail("缺少 keyword") end
		if not kw:match("^[%w%._%+%-]+$") then fail("关键词非法") end
		local rows = {}
		local outp = (pm == "apk") and exec("apk search " .. shq(kw)) or exec("opkg find " .. shq("*" .. kw .. "*"))
		for line in outp:gmatch("[^\n]+") do
			local pkg, ver
			if pm == "apk" then
				pkg, ver = line:match("^(.-)%-(%d[%w%.%-%+]*)%s*$")
				if not pkg then pkg, ver = line:match("^(%S+)%s*$"), "" end
			else
				pkg, ver = line:match("^(%S+)%s+%-%s+(%S+)")
			end
			if pkg then rows[#rows + 1] = { name = pkg, version = ver or "" } end
		end
		reply({ ok = true, packages = rows, manager = pm })
	elseif op == "update" then
		need_root()
		reply({ ok = true, output = exec(pm .. " update") })
	elseif op == "install" or op == "remove" then
		need_root()
		local pkg = tostring(arg("pkg") or "")
		if not valid_pkg(pkg) then fail("包名非法") end
		local cmd
		if pm == "apk" then cmd = (op == "install") and "apk add" or "apk del"
		else cmd = "opkg " .. op end
		reply({ ok = true, output = exec(cmd .. " " .. shq(pkg)) })
	else
		fail("未知 op")
	end
end

