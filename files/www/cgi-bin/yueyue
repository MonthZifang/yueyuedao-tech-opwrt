local function valid_host(h)
	return h and #h <= 253 and h:match("^[%w%.%-_:]+$") ~= nil
end

function act.diag()
	local dtype = tostring(arg("type") or "ping")
	local target = tostring(arg("target") or "")
	if not valid_host(target) then fail("目标地址非法") end
	local outp
	if dtype == "ping" then
		outp = exec("ping -c 4 -W 2 " .. shq(target) .. " | head -c 8192")
	elseif dtype == "trace" then
		-- 防止 uhttpd 因 CGI 长时间运行而 502：限制跳数/超时 + 截断输出
		outp = exec("traceroute -n -m 12 -w 1 -q 1 " .. shq(target) .. " | head -c 8192")
	elseif dtype == "nslookup" then
		outp = exec("nslookup " .. shq(target) .. " | head -c 8192")
	else
		fail("未知诊断类型")
	end
	if outp == "" then outp = "(无输出：命令不存在或执行超时)" end
	reply({ ok = true, output = outp })
end

function act.log()
	local n = math.min(argn("lines", 200), 1000)
	local filter = arg("filter")
	local cmd = "logread"
	if filter and #filter > 0 and #filter <= 64 and filter:match("^[%w%._%-%s]+$") then
		cmd = cmd .. " | grep -i " .. shq(filter)
	end
	cmd = cmd .. " | tail -n " .. n
	reply({ ok = true, output = exec(cmd) })
end

