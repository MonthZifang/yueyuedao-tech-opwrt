# 月月岛科技 企业定制 OpenWrt (x86_64) — 构建种子配置
# 基础分支: 官方 OpenWrt 25.12.x | 用法: make defconfig 后合并，或直接作为 .config 起点

CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y

# 固件格式: squashfs 可刷写镜像 + EFI + ISO
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_ISO_IMAGES=y
CONFIG_VDI_IMAGES=n
CONFIG_VMDK_IMAGES=n
CONFIG_VHDX_IMAGES=n
CONFIG_GRUB_EFI=y
CONFIG_GRUB_ROOT="sda"

# 基础组件
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-app-mwan3=y
CONFIG_PACKAGE_mwan3=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_miniupnpd=y

# 多拨/多线路
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_ppp-mod-pppoa=y

# 企业常用
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y

# 无线 (x86 通用驱动; 客户硬件具体网卡再补)
CONFIG_PACKAGE_wpad-mbedtls=y
CONFIG_PACKAGE_iwinfo=y
CONFIG_PACKAGE_wireless-regdb=y
CONFIG_PACKAGE_rpcd-mod-iwinfo=y
CONFIG_PACKAGE_kmod-ath9k=y
CONFIG_PACKAGE_kmod-ath10k=y
CONFIG_PACKAGE_kmod-mt76=y
CONFIG_PACKAGE_kmod-mt76x2=y

# 月月岛定制: 首次开机引导 (由 SDK 编出的本地 ipk 提供)
CONFIG_PACKAGE_luci-app-yueyuewizard=y

# 版本标识 (简洁版，暂不做品牌 logo)
CONFIG_IMAGEOPT=y
CONFIG_VERSION_DIST="月月岛科技"
CONFIG_VERSION_NUMBER="1.0.0"
CONFIG_VERSION_CODE="yueyuedao-v1"
CONFIG_VERSION_PRODUCT="YueYueDao Enterprise Router"
